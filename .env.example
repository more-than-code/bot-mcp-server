# bot-mcp-server. All three are required. The server has no credentials of its own.
# API URL and public origin must be https, except loopback (localhost, 127.0.0.1, ::1).
BOT_MCP_LISTEN=127.0.0.1:8091
BOT_MCP_API_URL=https://api.example
BOT_MCP_PUBLIC_ORIGIN=https://mcp.example

# Set to 1 to allow cleartext http for a non-loopback host (tailnet dev only).
# BOT_MCP_ALLOW_INSECURE_HTTP=1

# deploybot login / logout. --api overrides this.
# Non-loopback http is allowed only with the deploybot flag --insecure-http.
DEPLOYBOT_API_URL=https://api.example
